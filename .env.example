# Environment Configuration - SÉCURITÉ NOTES API

# ⚠️  IMPORTANT:
# 1. Copier ce fichier en .env
# 2. Remplir TOUTES les variables marquées [REQUIS]
# 3. Ne jamais commiter le fichier .env en git
# 4. Générer des valeurs aléatoires sécurisées pour les secrets

# VARIABLES REQUISES
# Clé secrète pour signer les JWT (JSON Web Tokens)
JWT_SECRET=your-secure-jwt-secret-change-this-in-production

# Clé de chiffrement des données au repos (AES-256)
STORAGE_ENCRYPTION_KEY=your-secure-storage-key-change-this-in-production

# Secret partagé entre Server A et Server B pour la réplication
REPLICATION_SECRET=your-shared-replication-secret-change-this-in-production

# CONFIGURATION DES PORTS
PORT_A=3001
PORT_B=3002

# CONFIGURATION DES URLS
FRONTEND_ORIGIN=http://localhost:3000
PEER_SERVER_URL=https://localhost:3001

# CONFIGURATION SUPPLÉMENTAIRE
# Niveau de log (debug, info, warn, error)
LOG_LEVEL=info

# Mode développement/production
NODE_ENV=development

# Timeout de réplication (ms)
REPLICATION_TIMEOUT=5000

# Intervalle de nettoyage de la blacklist des tokens (ms)
TOKEN_BLACKLIST_CLEANUP_INTERVAL=3600000