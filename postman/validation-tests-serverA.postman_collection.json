{
  "info": {
    "name": "Validation Tests - Server A",
    "description": "Tests de validation stricte des entrées"
  },
  "item": [
    {
      "name": "Register - Email invalide",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{BASE_URL}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"invalid-email\",\n  \"password\": \"P@ssw0rd2025!\"\n}"
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Status 400 pour email invalide', function() {",
            "  pm.response.to.have.status(400);",
            "});",
            "pm.test('Message d\\'erreur présent', function() {",
            "  const json = pm.response.json();",
            "  pm.expect(json).to.have.property('error');",
            "});"
          ]
        }
      }]
    },
    {
      "name": "Register - Mot de passe faible",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{BASE_URL}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"weak\"\n}"
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Status 400 pour mot de passe faible', function() {",
            "  pm.response.to.have.status(400);",
            "});",
            "pm.test('Message validation password', function() {",
            "  const json = pm.response.json();",
            "  pm.expect(json.error).to.include('Validation');",
            "});"
          ]
        }
      }]
    },
    {
      "name": "Create Note - Titre trop long",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{JWT_TOKEN}}"}
        ],
        "url": "{{BASE_URL}}/notes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"\n}"
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Status 400 pour titre trop long', function() {",
            "  pm.response.to.have.status(400);",
            "});",
            "pm.test('Erreur de validation titre', function() {",
            "  const json = pm.response.json();",
            "  pm.expect(json.details).to.have.property('title');",
            "});"
          ]
        }
      }]
    },
    {
      "name": "Create Note - Contenu vide",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{JWT_TOKEN}}"}
        ],
        "url": "{{BASE_URL}}/notes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Titre valide\",\n  \"content\": \"\"\n}"
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Status 400 pour contenu vide', function() {",
            "  pm.response.to.have.status(400);",
            "});",
            "pm.test('Erreur de validation contenu', function() {",
            "  const json = pm.response.json();",
            "  pm.expect(json.details).to.have.property('content');",
            "});"
          ]
        }
      }]
    },
    {
      "name": "Get Note - ID invalide (non UUID)",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{JWT_TOKEN}}"}],
        "url": "{{BASE_URL}}/notes/invalid-id-123"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Status 400 pour ID non-UUID', function() {",
            "  pm.response.to.have.status(400);",
            "});",
            "pm.test('Message erreur format ID', function() {",
            "  const json = pm.response.json();",
            "  pm.expect(json.details).to.have.property('id');",
            "});"
          ]
        }
      }]
    },
    {
      "name": "Update Note - Contenu trop long",
      "request": {
        "method": "PUT",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{JWT_TOKEN}}"}
        ],
        "url": "{{BASE_URL}}/notes/{{NOTE_ID}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"\n}"
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Status 400 pour contenu trop long', function() {",
            "  pm.response.to.have.status(400);",
            "});",
            "pm.test('Erreur limite contenu', function() {",
            "  const json = pm.response.json();",
            "  pm.expect(json.error).to.include('Validation');",
            "});"
          ]
        }
      }]
    }
  ]
}