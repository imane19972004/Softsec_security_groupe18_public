  "item": [
    {
      "name": "Register User",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": { "raw": "{{BASE_URL}}/auth/register", "host": ["{{BASE_URL}}"],"path": ["auth","register"]},
        "body": { "mode": "raw","raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"P@ssw0rd2025!\"\n}"}
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const name = pm.info.requestName || \"\";",
              "const isNegativeName = /(Invalid|Unauthorized|Wrong|Already Exists)/i.test(name);",
              "",
              "pm.test(\"Status code is expected (2xx for success, 4xx for negative)\", function () {",
              "    const code = pm.response.code;",
              "    if (/(Unauthorized)/i.test(name)) {",
              "        pm.expect(code).to.eql(401);",
              "    } else if (isNegativeName) {",
              "        pm.expect(code).to.be.within(400, 499);",
              "    } else {",
              "        pm.expect(code).to.be.within(200, 299);",
              "    }",
              "});",
              "",
              "pm.test(\"Response time is under 2000ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});",
              "",
              "pm.test(\"If JSON, body is valid JSON\", function () {",
              "    const ct = pm.response.headers.get('Content-Type') || \"\";",
              "    if (ct.includes('application/json')) {",
              "        pm.expect(function () {",
              "            pm.response.json();",
              "        }).to.not.throw();",
              "    }",
              "});",
              "",
              "// Endpoint-specific tests: Register User (success)",
              "if (!isNegativeName) {",
              "    pm.test(\"Register User: response has user id or email\", function () {",
              "        const json = pm.response.json();",
              "        pm.expect(json).to.be.an('object');",
              "        pm.expect(json).to.satisfy(obj => obj.id || obj.userId || obj.email, 'id/userId/email should be present');",
              "    });",
              "}"
            ]
          }
        }
      ]
    },
